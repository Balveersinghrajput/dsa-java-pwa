# Copy to .env.local and fill in.
ADMIN_EMAIL=you@example.com
# Generate with: node scripts/hash-password.mjs "YourPassword"
ADMIN_PASSWORD_HASH=
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_URL=http://localhost:3000
# Optional: where admin data is stored (defaults to ./.data)
# ADMIN_DATA_DIR=

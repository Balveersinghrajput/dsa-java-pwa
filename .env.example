# Copy to .env.local (and add the same variables in Vercel → Project → Settings → Environment Variables).

# ---- Sign-in ----
ADMIN_EMAIL=you@example.com
# Generate with: node scripts/hash-password.mjs "YourPassword"   (only the hash is stored)
ADMIN_PASSWORD_HASH=
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ---- Storage (required on Vercel) ----
# Vercel → Storage → Marketplace → Upstash (Redis) → connect to this project. That adds
# KV_REST_API_URL / KV_REST_API_TOKEN (or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN) automatically.
# Without them, data is kept in ./.data (fine for local / a single VPS, not for Vercel).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# ACCOUNT_DATA_DIR=

# ---- Email (forgot password) ----
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS (spaces are fine).
# Check it with: node scripts/test-email.mjs
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Public address of the site, used in the reset link (e.g. https://your-app.vercel.app)
APP_URL=http://localhost:3000

# ---- Behind a proxy (Vercel, Nginx…) ----
# TRUST_PROXY=1
